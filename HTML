<!-- Toast -->
<div class="toast" id="toast"></div>

<script>
  const STORAGE_KEY = 'creator_applications';
  const COUNTER_KEY = 'creator_counter';
  const PROFILE_KEY = 'user_profile';

  function getApplications() { try { return JSON.parse(localStorage.getItem(STORAGE_KEY)) || []; } catch { return []; } }
  function saveApplications(apps) { localStorage.setItem(STORAGE_KEY, JSON.stringify(apps)); }
  function getCounter() { try { return JSON.parse(localStorage.getItem(COUNTER_KEY)) || { batch: 1, sequence: 0 }; } catch { return { batch: 1, sequence: 0 }; } }
  function saveCounter(counter) { localStorage.setItem(COUNTER_KEY, JSON.stringify(counter)); }
  function getProfile() { try { return JSON.parse(localStorage.getItem(PROFILE_KEY)) || null; } catch { return null; } }
  function saveProfileData(data) { localStorage.setItem(PROFILE_KEY, JSON.stringify(data)); }

  function previewCreatorId(name) {
    const counter = getCounter();
    const firstName = name.trim().charAt(0).toUpperCase();
    const lastName = name.trim().split(/\s+/).pop().charAt(0).toUpperCase();
    const nextSeq = counter.sequence + 1;
    const batchStr = String(counter.batch).padStart(2, '0');
    const seqStr = String(nextSeq).padStart(5, '0');
    return `${firstName}${batchStr}${lastName}${seqStr}`;
  }

  function generateCreatorId(name) {
    const counter = getCounter();
    const firstName = name.trim().charAt(0).toUpperCase();
    const lastName = name.trim().split(/\s+/).pop().charAt(0).toUpperCase();
    counter.sequence++;
    if (counter.sequence > 99999) { counter.sequence = 1; counter.batch++; }
    const batchStr = String(counter.batch).padStart(2, '0');
    const seqStr = String(counter.sequence).padStart(5, '0');
    const creatorId = `${firstName}${batchStr}${lastName}${seqStr}`;
    saveCounter(counter);
    return creatorId;
  }

  function updateLiveCreatorId() {
    const name = document.getElementById('creatorName').value.trim();
    const liveBox = document.getElementById('liveCreatorIdBox');
    const liveId = document.getElementById('liveCreatorId');
    if (name.length >= 2) {
      liveId.textContent = previewCreatorId(name);
      liveId.classList.remove('placeholder');
      liveBox.classList.add('active');
    } else {
      liveId.textContent = 'Enter name to generate ID';
      liveId.classList.add('placeholder');
      liveBox.classList.remove('active');
    }
  }

  let isAgreeChecked = false;
  function toggleAgreeCheckbox(event) {
    if (event) event.stopPropagation();
    isAgreeChecked = !isAgreeChecked;
    document.getElementById('agreeCheckboxWrap').classList.toggle('checked', isAgreeChecked);
  }

  function openCreatorForm() {
    const profile = getProfile();
    if (profile && profile.status === 'approved') { showToast('✅ You are already an approved Creator!'); return; }
    if (profile && profile.status === 'pending') { showToast('⏳ Your application is pending approval'); return; }
    document.getElementById('creatorName').value = '';
    document.getElementById('creatorHandle').value = '';
    document.getElementById('creatorMobile').value = '';
    document.getElementById('creatorEmail').value = '';
    document.getElementById('creatorCategory').value = '';
    document.getElementById('creatorLanguage').value = '';
    document.getElementById('creatorAbout').value = '';
    isAgreeChecked = false;
    document.getElementById('agreeCheckboxWrap').classList.remove('checked');
    document.getElementById('liveCreatorId').textContent = 'Enter name to generate ID';
    document.getElementById('liveCreatorId').classList.add('placeholder');
    document.getElementById('liveCreatorIdBox').classList.remove('active');
    openModal('creatorModal');
  }

  function handleCreatorSubmit() {
    const name = document.getElementById('creatorName').value.trim();
    const handle = document.getElementById('creatorHandle').value.trim();
    const mobile = document.getElementById('creatorMobile').value.trim();
    const email = document.getElementById('creatorEmail').value.trim();
    const category = document.getElementById('creatorCategory').value;
    const language = document.getElementById('creatorLanguage').value;
    const about = document.getElementById('creatorAbout').value.trim();
    if (!name) { showToast('⚠️ Please enter Channel Name'); return; }
    if (!handle) { showToast('⚠️ Please enter Handle'); return; }
    if (!mobile) { showToast('⚠️ Please enter Mobile Number'); return; }
    if (!email) { showToast('⚠️ Please enter Gmail ID'); return; }
    if (!category) { showToast('⚠️ Please select Video Category'); return; }
    if (!language) { showToast('⚠️ Please select Language'); return; }
    if (!about) { showToast('⚠️ Please enter About details'); return; }
    if (!isAgreeChecked) { showToast('⚠️ Please agree to the terms'); return; }
    const creatorId = generateCreatorId(name);
    const application = { id: creatorId, name, handle, mobile, email, category, language, about, status: 'pending', submittedAt: new Date().toISOString() };
    const apps = getApplications();
    apps.push(application);
    saveApplications(apps);
    saveProfileData(application);
    document.getElementById('generatedCreatorId').textContent = creatorId;
    document.getElementById('applicationSummary').innerHTML = `<div><strong>Name:</strong> <span>${name}</span></div><div><strong>Handle:</strong> <span>${handle}</span></div><div><strong>Email:</strong> <span>${email}</span></div><div><strong>Mobile:</strong> <span>${mobile}</span></div><div><strong>Category:</strong> <span>${category}</span></div><div><strong>Language:</strong> <span>${language}</span></div><div><strong>Creator ID:</strong> <span style="color:#818cf8;font-family:monospace;">${creatorId}</span></div>`;
    closeModal('creatorModal');
    setTimeout(() => { openModal('creatorIdModal'); }, 300);
    loadProfile();
    showToast('✅ Application submitted successfully!');
  }

  function loadProfile() {
    const profile = getProfile();
    const nameEl = document.getElementById('profileDisplayName');
    const handleEl = document.getElementById('profileDisplayHandle');
    const emailEl = document.getElementById('profileDisplayEmail');
    const statusEl = document.getElementById('profileStatusBadge');
    const statusText = document.getElementById('profileStatusText');
    const idEl = document.getElementById('profileCreatorId');
    const avatarEl = document.getElementById('profileAvatar');
    const postsEl = document.getElementById('statPosts');
    const uploadsEl = document.getElementById('analyticsUploads');

    const posts = JSON.parse(localStorage.getItem('user_posts') || '[]');
    if (postsEl) postsEl.textContent = posts.length;
    if (uploadsEl) uploadsEl.textContent = posts.length + ' Uploads Total';

    if (profile && profile.name) {
      nameEl.textContent = profile.name;
      handleEl.textContent = profile.handle;
      emailEl.textContent = profile.email || '';
      emailEl.style.display = profile.email ? 'block' : 'none';
      if (profile.status === 'approved') {
        statusEl.className = 'profile-status-badge status-approved';
        statusText.textContent = '✓ VERIFIED CREATOR';
        idEl.style.display = 'block';
        idEl.textContent = 'ID: ' + profile.id;
      } else if (profile.status === 'pending') {
        statusEl.className = 'profile-status-badge status-pending';
        statusText.textContent = '⏳ PENDING APPROVAL';
        idEl.style.display = 'block';
        idEl.textContent = 'ID: ' + profile.id;
      } else {
        statusEl.className = 'profile-status-badge status-none';
        statusText.textContent = 'Not a Creator';
        idEl.style.display = 'none';
      }
      const initial = profile.name.charAt(0).toUpperCase();
      avatarEl.innerHTML = `<span style="font-size:32px;font-weight:800;color:#f5a623;">${initial}</span>`;
    } else {
      nameEl.textContent = 'Your Channel Name';
      handleEl.textContent = '@username';
      emailEl.textContent = '';
      emailEl.style.display = 'none';
      statusEl.className = 'profile-status-badge status-none';
      statusText.textContent = 'Not a Creator';
      idEl.style.display = 'none';
      avatarEl.innerHTML = `<svg viewBox="0 0 24 24" fill="#f5a623" width="48" height="48"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 14.2c-2.5 0-4.71-1.28-6-3.22.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08-1.29 1.94-3.5 3.22-6 3.22z"/></svg>`;
    }
  }

  function openAdminPanel() {
    const apps = getApplications();
    const pending = apps.filter(a => a.status === 'pending');
    const list = document.getElementById('adminPendingList');
    if (pending.length === 0) {
      list.innerHTML = '<div style="text-align:center;padding:30px 0;color:#888;"><div style="font-size:40px;margin-bottom:10px;">📭</div><div style="font-size:14px;">No pending applications</div></div>';
    } else {
      list.innerHTML = pending.map(app => `<div class="admin-pending-item"><div class="admin-pending-header"><div class="admin-pending-name">${app.name}</div><div class="admin-pending-id">${app.id}</div></div><div class="admin-pending-details"><div><strong>Handle:</strong> <span>${app.handle}</span></div><div><strong>Email:</strong> <span>${app.email}</span></div><div><strong>Mobile:</strong> <span>${app.mobile}</span></div><div><strong>Category:</strong> <span>${app.category}</span></div><div><strong>Language:</strong> <span>${app.language}</span></div></div><div class="admin-actions"><button class="admin-approve-btn" onclick="approveCreator('${app.id}')">✓ Approve</button><button class="admin-reject-btn" onclick="rejectCreator('${app.id}')">✗ Reject</button></div></div>`).join('');
    }
    openModal('adminModal');
  }

  function approveCreator(id) {
    const apps = getApplications();
    const app = apps.find(a => a.id === id);
    if (app) {
      app.status = 'approved';
      saveApplications(apps);
      const profile = getProfile();
      if (profile && profile.id === id) { profile.status = 'approved'; saveProfileData(profile); }
      showToast('✅ Creator approved: ' + id);
      openAdminPanel();
      loadProfile();
    }
  }

  function rejectCreator(id) {
    const apps = getApplications();
    const app = apps.find(a => a.id === id);
    if (app) {
      app.status = 'rejected';
      saveApplications(apps);
      const profile = getProfile();
      if (profile && profile.id === id) { profile.status = 'rejected'; saveProfileData(profile); }
      showToast('❌ Creator rejected: ' + id);
      openAdminPanel();
      loadProfile();
    }
  }

  // ===== PAGE SWITCHING =====
  function switchPage(page) {
    // Hide all pages
    document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
    // Show selected page
    document.getElementById(page + 'Page').classList.add('active');
    // Update nav buttons
    document.querySelectorAll('.nav-btn').forEach(b => {
      b.classList.remove('active');
      const svg = b.querySelector('svg');
      if (svg) {
        svg.setAttribute('fill', 'none');
        svg.setAttribute('stroke', '#888');
      }
    });
    const activeNav = document.getElementById('nav' + page.charAt(0).toUpperCase() + page.slice(1));
    if (activeNav) {
      activeNav.classList.add('active');
      const svg = activeNav.querySelector('svg');
      if (svg) {
        svg.setAttribute('fill', '#f5a623');
        svg.removeAttribute('stroke');
      }
    }
    // Load profile data when switching to profile
    if (page === 'profile') loadProfile();
    // Scroll to top
    window.scrollTo(0, 0);
  }

  function switchToProfile() {
    switchPage('profile');
  }

  // ===== VIDEO PLAYER =====
  let isPlaying = true;
  let isLiked = false;
  let likeCountVal = 0;
  let viewCountVal = 107;
  let commentCountVal = 0;
  let progressInterval;
  let currentProgress = 0;
  let lastTap = 0;

  function togglePlay() {
    isPlaying = !isPlaying;
    const playIcon = document.getElementById('playIconBig');
    const pauseIcon = document.getElementById('pauseIcon');
    if (isPlaying) {
      playIcon.classList.remove('show');
      pauseIcon.innerHTML = '<rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/>';
      startProgress();
    } else {
      playIcon.classList.add('show');
      pauseIcon.innerHTML = '<path d="M8 5v14l11-7z"/>';
      stopProgress();
      setTimeout(() => playIcon.classList.remove('show'), 800);
    }
  }

  function startProgress() {
    stopProgress();
    progressInterval = setInterval(() => {
      currentProgress += 0.33;
      if (currentProgress >= 100) {
        currentProgress = 0;
        isPlaying = false;
        document.getElementById('playIconBig').classList.add('show');
        document.getElementById('pauseIcon').innerHTML = '<path d="M8 5v14l11-7z"/>';
        stopProgress();
      }
      document.getElementById('progressFill').style.width = currentProgress + '%';
      const secs = Math.floor(currentProgress * 0.3);
      const m = Math.floor(secs / 60);
      const s = secs % 60;
      document.getElementById('timeDisplay').textContent = `${m}:${s.toString().padStart(2,'0')} / 0:30`;
    }, 100);
  }

  function stopProgress() { clearInterval(progressInterval); }

  function seekVideo(e) {
    const bar = document.getElementById('progressBar');
    const rect = bar.getBoundingClientRect();
    const pct = ((e.clientX - rect.left) / rect.width) * 100;
    currentProgress = Math.max(0, Math.min(100, pct));
    document.getElementById('progressFill').style.width = currentProgress + '%';
    const secs = Math.floor(currentProgress * 0.3);
    const m = Math.floor(secs / 60);
    const s = secs % 60;
    document.getElementById('timeDisplay').textContent = `${m}:${s.toString().padStart(2,'0')} / 0:30`;
  }

  function toggleLike() {
    const btn = document.getElementById('likeBtn');
    const svg = btn.querySelector('svg');
    if (isLiked) {
      isLiked = false;
      likeCountVal--;
      svg.setAttribute('fill', 'none');
      svg.setAttribute('stroke', '#fff');
      btn.classList.remove('liked');
    } else {
      isLiked = true;
      likeCountVal++;
      svg.setAttribute('fill', '#e74c3c');
      svg.setAttribute('stroke', '#e74c3c');
      btn.classList.add('liked');
      svg.style.transform = 'scale(1.3)';
      setTimeout(() => svg.style.transform = 'scale(1)', 200);
    }
    document.getElementById('likeCount').textContent = likeCountVal;
  }

  document.getElementById('playOverlay').addEventListener('click', function(e) {
    const now = Date.now();
    if (now - lastTap < 300) {
      if (!isLiked) toggleLike();
      showDoubleTapHeart(e);
    }
    lastTap = now;
  });

  function showDoubleTapHeart(e) {
    const heart = document.getElementById('doubleTapHeart');
    const container = document.getElementById('videoContainer');
    const rect = container.getBoundingClientRect();
    heart.style.left = (e.clientX - rect.left - 50) + 'px';
    heart.style.top = (e.clientY - rect.top - 50) + 'px';
    heart.classList.remove('fade');
    heart.classList.add('show');
    setTimeout(() => heart.classList.add('fade'), 400);
    setTimeout(() => heart.classList.remove('show', 'fade'), 1000);
  }

  function showViews() { viewCountVal++; document.getElementById('viewCount').textContent = viewCountVal; }
  function switchFeedTab(el) { document.querySelectorAll('.feed-tab').forEach(t => t.classList.remove('active')); el.classList.add('active'); }
  function toggleSound(btn) { showToast('🔊 Sound toggled'); }

  function openComments() { openModal('commentModal'); }
  function postComment() {
    const input = document.getElementById('commentInput');
    const text = input.value.trim();
    if (!text) return;
    commentCountVal++;
    document.getElementById('commentCount').textContent = commentCountVal;
    document.querySelector('#commentModal .modal-header').textContent = 'Comments (' + commentCountVal + ')';
    const list = document.getElementById('commentsList');
    if (commentCountVal === 1) list.innerHTML = '';
    const item = document.createElement('div');
    item.style.cssText = 'display:flex;gap:10px;padding:12px 0;border-bottom:1px solid rgba(255,255,255,0.05);';
    item.innerHTML = `<div style="width:36px;height:36px;border-radius:50%;background:linear-gradient(135deg,#f5a623,#e6951a);display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:700;flex-shrink:0;">U</div><div style="flex:1;"><div style="font-size:13px;font-weight:600;color:#f5a623;">You</div><div style="font-size:13px;color:#ccc;margin-top:2px;">${text}</div><div style="font-size:11px;color:#666;margin-top:4px;">Just now</div></div>`;
    list.prepend(item);
    input.value = '';
  }
  function handleCommentKey(e) { if (e.key === 'Enter') postComment(); }

  function shareVideo() {
    if (navigator.share) {
      navigator.share({ title: 'Check this video!', url: window.location.href }).catch(() => {});
    } else {
      showToast('📤 Share link copied!');
    }
  }

  // ===== UPLOAD MODAL =====
  let currentUploadTab = 'regular';
  let selectedFile = null;

  function openUploadModal() {
    document.getElementById('uploadModal').classList.add('open');
    document.body.style.overflow = 'hidden';
  }
  function closeUploadModal() {
    document.getElementById('uploadModal').classList.remove('open');
    document.body.style.overflow = '';
  }
  function switchUploadTab(tab) {
    currentUploadTab = tab;
    document.getElementById('tabRegular').classList.toggle('active', tab === 'regular');
    document.getElementById('tabPromote').classList.toggle('active', tab === 'promote');
  }
  function selectVideo() { document.getElementById('videoFileInput').click(); }
  function selectPhoto() { document.getElementById('photoFileInput').click(); }
  function handleVideoSelect(event) {
    const file = event.target.files[0];
    if (file) { selectedFile = file; showFilePreview(file, 'video'); showToast('📹 Video selected: ' + file.name); }
  }
  function handlePhotoSelect(event) {
    const file = event.target.files[0];
    if (file) { selectedFile = file; showFilePreview(file, 'photo'); showToast('🖼️ Photo selected: ' + file.name); }
  }
  function handleAudioSelect(event) {
    const file = event.target.files[0];
    if (file) { document.getElementById('soundTitle').value = file.name.replace(/\.[^/.]+$/, ''); showToast('🎵 Audio attached: ' + file.name); }
  }
  function showFilePreview(file, type) {
    const preview = document.getElementById('filePreview');
    document.getElementById('filePreviewName').textContent = file.name;
    document.getElementById('filePreviewSize').textContent = (file.size / (1024 * 1024)).toFixed(2) + ' MB';
    const iconSvg = document.getElementById('filePreviewIconSvg');
    iconSvg.innerHTML = type === 'video' ? '<path d="M17 10.5V7c0-.55-.45-1-1-1H4c-.55 0-1 .45-1 1v10c0 .55.45 1 1 1h12c.55 0 1-.45 1-1v-3.5l4 4v-11l-4 4z"/>' : '<path d="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z"/>';
    preview.classList.add('show');
  }
  function removeFile() {
    selectedFile = null;
    document.getElementById('filePreview').classList.remove('show');
    document.getElementById('videoFileInput').value = '';
    document.getElementById('photoFileInput').value = '';
    showToast('🗑️ File removed');
  }
  function attachAudio() { document.getElementById('audioFileInput').click(); }
  function newSeries() {
    const seriesName = prompt('Enter new series name:');
    if (seriesName) {
      const select = document.getElementById('seriesSelect');
      const option = document.createElement('option');
      option.textContent = seriesName + ' — Episode 1';
      select.appendChild(option);
      select.value = option.textContent;
      showToast('📺 New series created: ' + seriesName);
    }
  }
  function publishNow() {
    if (!selectedFile) { showToast('⚠️ Please select a video or photo first'); return; }
    const caption = document.getElementById('uploadCaption').value.trim();
    const soundTitle = document.getElementById('soundTitle').value.trim();
    const posts = JSON.parse(localStorage.getItem('user_posts') || '[]');
    posts.push({ id: Date.now(), fileName: selectedFile.name, fileType: selectedFile.type, caption, soundTitle, uploadType: currentUploadTab, views: 0, likes: 0, shares: 0, createdAt: new Date().toISOString() });
    localStorage.setItem('user_posts', JSON.stringify(posts));
    const profile = getProfile();
    if (profile) { profile.posts = (profile.posts || 0) + 1; saveProfileData(profile); }
    showToast('🎉 Published successfully!');
    closeUploadModal();
    loadProfile();
    selectedFile = null;
    document.getElementById('filePreview').classList.remove('show');
    document.getElementById('uploadCaption').value = '';
    document.getElementById('videoFileInput').value = '';
    document.getElementById('photoFileInput').value = '';
  }

  // ===== MODAL HELPERS =====
  function openModal(id) {
    document.getElementById(id).classList.add('open');
    document.body.style.overflow = 'hidden';
  }
  function closeModal(id) {
    document.getElementById(id).classList.remove('open');
    document.body.style.overflow = '';
  }

  document.querySelectorAll('.modal-overlay').forEach(m => {
    m.addEventListener('click', (e) => {
      if (e.target === m) {
        if (m.id === 'uploadModal') closeUploadModal();
        else closeModal(m.id);
      }
    });
  });

  function showToast(msg) {
    const t = document.getElementById('toast');
    t.textContent = msg;
    t.classList.add('show');
    setTimeout(() => t.classList.remove('show'), 2200);
  }

  // Admin shortcut - triple tap wallet
  let walletTapCount = 0;
  document.querySelector('.profile-wallet-btn').addEventListener('click', () => {
    walletTapCount++;
    if (walletTapCount >= 3) { walletTapCount = 0; openAdminPanel(); }
    setTimeout(() => { walletTapCount = 0; }, 1000);
  });

  // Start video progress
  startProgress();

  // Load profile on start
  loadProfile();
</script>
</body>
</html>
