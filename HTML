<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>MixMedia App</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/fontsource-poppins@5.0.0/index.css">
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
  body {
    font-family: 'Poppins', sans-serif;
    background: #0a0a0a;
    color: #fff;
    overflow-x: hidden;
    min-height: 100vh;
    max-width: 480px;
    margin: 0 auto;
    position: relative;
  }

  /* Page Container */
  .page { display: none; min-height: 100vh; padding-bottom: 75px; }
  .page.active { display: block; }

  /* ===== HOME PAGE (Video Feed) ===== */
  .home-page { position: relative; height: 100vh; overflow: hidden; padding-bottom: 75px; }
  .video-container {
    position: relative;
    height: calc(100vh - 75px);
    overflow: hidden;
    background: #000;
  }
  .video-bg {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, #1a1a2e 0%, #16213e 30%, #0f3460 60%, #1a1a2e 100%);
  }
  .kitchen-scene {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, #2a1f1a 0%, #1a1510 100%);
  }
  .fridge {
    position: absolute;
    left: 0; top: 10%;
    width: 35%; height: 80%;
    background: linear-gradient(90deg, #c0c0c0, #e8e8e8, #c0c0c0);
    border-radius: 4px;
  }
  .fridge-inner {
    position: absolute;
    left: 5%; top: 5%;
    width: 85%; height: 90%;
    background: linear-gradient(180deg, #f0f0f0, #d8d8d8);
    border-radius: 2px;
  }
  .fridge-shelf {
    position: absolute;
    left: 5%; right: 5%;
    height: 2px;
    background: #bbb;
  }
  .fridge-light {
    position: absolute;
    top: 0; left: 10%; right: 10%;
    height: 30%;
    background: linear-gradient(180deg, rgba(255,255,200,0.3), transparent);
  }
  .person-silhouette {
    position: absolute;
    right: 10%; bottom: 5%;
    width: 50%; height: 85%;
    background: linear-gradient(180deg, #3a3a4a, #2a2a3a);
    border-radius: 40px 40px 0 0;
    opacity: 0.8;
  }
  .cake-hold {
    position: absolute;
    right: 25%; bottom: 35%;
    width: 18%; height: 12%;
    background: linear-gradient(180deg, #fff, #f5f0e8);
    border-radius: 8px 8px 4px 4px;
    box-shadow: 0 0 10px rgba(255,200,200,0.3);
  }
  .cake-top {
    position: absolute;
    top: -4px; left: 10%; right: 10%;
    height: 6px;
    background: #e74c3c;
    border-radius: 3px;
  }
  .clock-wall {
    position: absolute;
    right: 20%; top: 15%;
    width: 40px; height: 40px;
    border-radius: 50%;
    border: 2px solid #888;
    background: #222;
  }
  .video-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0,0,0,0.3) 0%, transparent 30%, transparent 60%, rgba(0,0,0,0.6) 100%);
  }

  /* Top Tabs */
  .top-tabs {
    position: absolute;
    top: 0; left: 0; right: 0;
    display: flex;
    align-items: center;
    padding: 12px 16px;
    gap: 10px;
    z-index: 50;
  }
  .feed-tab {
    padding: 8px 18px;
    border-radius: 25px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    border: 1.5px solid rgba(255,255,255,0.15);
    background: rgba(0,0,0,0.4);
    color: #ccc;
    transition: all 0.3s;
    white-space: nowrap;
  }
  .feed-tab.active {
    background: #f5a623;
    color: #000;
    border-color: #f5a623;
  }
  .sound-toggle {
    margin-left: auto;
    width: 42px; height: 42px;
    border-radius: 50%;
    border: 2px solid rgba(255,255,255,0.2);
    background: rgba(0,0,0,0.5);
    display: flex; align-items: center; justify-content: center;
    cursor: pointer;
  }
  .sound-toggle svg { width: 22px; height: 22px; fill: #f5a623; }

  /* Play/Pause overlay */
  .play-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 10;
  }
  .play-icon-big {
    width: 70px; height: 70px;
    background: rgba(0,0,0,0.5);
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    opacity: 0;
    transition: opacity 0.3s;
    pointer-events: none;
  }
  .play-icon-big.show { opacity: 1; }
  .play-icon-big svg { width: 35px; height: 35px; fill: #fff; margin-left: 4px; }

  /* Right Side Actions */
  .right-actions {
    position: absolute;
    right: 12px;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    z-index: 20;
  }
  .profile-pic-feed {
    width: 48px; height: 48px;
    border-radius: 50%;
    border: 2.5px solid #f5a623;
    overflow: hidden;
    cursor: pointer;
    background: linear-gradient(135deg, #1a1a3e, #0a0a2e);
    display: flex; align-items: center; justify-content: center;
  }
  .profile-pic-feed svg { width: 28px; height: 28px; }
  .feed-action-btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
    cursor: pointer;
    transition: transform 0.2s;
  }
  .feed-action-btn:active { transform: scale(0.85); }
  .feed-action-btn svg { width: 30px; height: 30px; }
  .feed-action-btn .count {
    font-size: 12px;
    font-weight: 700;
    color: #fff;
  }
  .feed-action-btn.liked svg { fill: #e74c3c; }
  .share-btn-feed svg { fill: #25D366; }

  /* Bottom Info */
  .bottom-feed-info {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 60px;
    padding: 0 16px 10px;
    z-index: 20;
  }
  .sound-info-feed {
    display: flex;
    align-items: center;
    gap: 8px;
    background: rgba(0,0,0,0.5);
    border: 1.5px solid rgba(245,166,35,0.4);
    border-radius: 25px;
    padding: 8px 16px;
    margin-bottom: 10px;
    cursor: pointer;
  }
  .sound-bars {
    display: flex;
    align-items: flex-end;
    gap: 2px;
    height: 18px;
  }
  .sound-bar {
    width: 3px;
    background: #f5a623;
    border-radius: 2px;
    animation: soundPulse 0.8s ease-in-out infinite alternate;
  }
  .sound-bar:nth-child(1) { height: 8px; animation-delay: 0s; }
  .sound-bar:nth-child(2) { height: 14px; animation-delay: 0.2s; }
  .sound-bar:nth-child(3) { height: 10px; animation-delay: 0.4s; }
  .sound-bar:nth-child(4) { height: 16px; animation-delay: 0.1s; }
  .sound-bar:nth-child(5) { height: 6px; animation-delay: 0.3s; }
  @keyframes soundPulse {
    0% { transform: scaleY(0.5); }
    100% { transform: scaleY(1); }
  }
  .sound-info-text {
    font-size: 13px;
    color: #f5a623;
    font-weight: 500;
  }
  .creator-info-feed {
    margin-bottom: 10px;
  }
  .creator-name-feed {
    font-size: 16px;
    font-weight: 700;
  }
  .creator-label-feed {
    font-size: 13px;
    color: #aaa;
    margin-left: 6px;
  }
  .comment-input-feed {
    display: flex;
    align-items: center;
    background: rgba(255,255,255,0.08);
    border: 1.5px solid rgba(245,166,35,0.3);
    border-radius: 25px;
    padding: 10px 16px;
    margin-bottom: 10px;
    cursor: pointer;
  }
  .comment-input-feed svg { width: 20px; height: 20px; fill: #f5a623; margin-right: 10px; flex-shrink: 0; }
  .comment-input-feed span { color: #888; font-size: 14px; }
  .progress-wrap-feed {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .pause-btn-feed {
    width: 38px; height: 38px;
    border-radius: 50%;
    border: 2px solid rgba(255,255,255,0.3);
    background: rgba(0,0,0,0.5);
    display: flex; align-items: center; justify-content: center;
    cursor: pointer;
    flex-shrink: 0;
  }
  .pause-btn-feed svg { width: 16px; height: 16px; fill: #fff; }
  .progress-bar-container-feed {
    flex: 1;
    height: 4px;
    background: rgba(255,255,255,0.2);
    border-radius: 2px;
    cursor: pointer;
    position: relative;
  }
  .progress-bar-fill-feed {
    height: 100%;
    background: #f5a623;
    border-radius: 2px;
    width: 0%;
    position: relative;
  }
  .progress-dot-feed {
    position: absolute;
    right: -6px; top: 50%;
    transform: translateY(-50%);
    width: 12px; height: 12px;
    background: #f5a623;
    border-radius: 50%;
    border: 2px solid #fff;
  }
  .time-display-feed {
    font-size: 12px;
    color: #ccc;
    font-weight: 500;
    white-space: nowrap;
    flex-shrink: 0;
  }

  /* Double tap heart */
  .double-tap-heart {
    position: absolute;
    font-size: 100px;
    z-index: 30;
    pointer-events: none;
    opacity: 0;
    transform: scale(0);
    transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .double-tap-heart.show { opacity: 1; transform: scale(1); }
  .double-tap-heart.fade { opacity: 0; transform: scale(1.5); }

  /* ===== MESSAGES PAGE ===== */
  .messages-page { background: #0a0a0a; }
  .messages-header {
    padding: 16px 16px 12px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .messages-header-left h1 {
    font-size: 24px;
    font-weight: 800;
    color: #fff;
  }
  .messages-header-left p {
    font-size: 13px;
    color: #888;
  }
  .messages-compose-btn {
    width: 44px; height: 44px;
    background: rgba(245,166,35,0.15);
    border: 1.5px solid rgba(245,166,35,0.4);
    border-radius: 12px;
    display: flex; align-items: center; justify-content: center;
    cursor: pointer;
  }
  .messages-compose-btn svg { width: 22px; height: 22px; fill: #f5a623; }
  .messages-search {
    margin: 0 16px 16px;
    display: flex;
    align-items: center;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 12px;
    padding: 12px 16px;
    gap: 10px;
  }
  .messages-search svg { width: 20px; height: 20px; fill: #666; flex-shrink: 0; }
  .messages-search input {
    flex: 1;
    background: none;
    border: none;
    color: #fff;
    font-size: 14px;
    font-family: 'Poppins', sans-serif;
    outline: none;
  }
  .messages-search input::placeholder { color: #666; }
  .messages-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 80px 20px;
    text-align: center;
  }
  .messages-empty-icon {
    width: 64px; height: 64px;
    background: rgba(245,166,35,0.1);
    border: 1px solid rgba(245,166,35,0.2);
    border-radius: 16px;
    display: flex; align-items: center; justify-content: center;
    margin-bottom: 16px;
  }
  .messages-empty-icon svg { width: 32px; height: 32px; fill: #f5a623; }
  .messages-empty h3 {
    font-size: 18px;
    font-weight: 700;
    color: #fff;
    margin-bottom: 6px;
  }
  .messages-empty p {
    font-size: 13px;
    color: #888;
    line-height: 1.5;
  }

  /* ===== PROFILE PAGE ===== */
  .profile-page { background: #0a0a0a; }
  .profile-top-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 10px 6px;
    position: sticky;
    top: 0;
    background: #0a0a0a;
    z-index: 100;
    gap: 6px;
  }
  .profile-back-btn {
    width: 38px; height: 38px;
    display: flex; align-items: center; justify-content: center;
    cursor: pointer;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .profile-back-btn svg { width: 22px; height: 22px; fill: #fff; }
  .profile-header-actions {
    display: flex;
    align-items: center;
    gap: 5px;
    flex-wrap: nowrap;
  }
  .profile-wallet-btn, .profile-arts-btn, .profile-login-btn {
    display: flex;
    align-items: center;
    gap: 5px;
    border-radius: 22px;
    padding: 7px 12px;
    cursor: pointer;
    white-space: nowrap;
    border: 1.5px solid;
  }
  .profile-wallet-btn { background: rgba(245,166,35,0.12); border-color: rgba(245,166,35,0.45); }
  .profile-wallet-btn svg { width: 17px; height: 17px; fill: #f5a623; }
  .profile-wallet-btn span { color: #f5a623; font-size: 13px; font-weight: 700; }
  .profile-arts-btn { background: rgba(245,166,35,0.12); border-color: rgba(245,166,35,0.45); }
  .profile-arts-btn svg { width: 15px; height: 15px; fill: #f5a623; }
  .profile-arts-btn span { color: #f5a623; font-size: 12px; font-weight: 600; }
  .profile-login-btn { background: rgba(99,102,241,0.15); border-color: rgba(99,102,241,0.5); }
  .profile-login-btn svg { width: 15px; height: 15px; fill: #818cf8; }
  .profile-login-btn span { color: #818cf8; font-size: 12px; font-weight: 600; }
  .profile-icon-btn {
    width: 38px; height: 38px;
    display: flex; align-items: center; justify-content: center;
    cursor: pointer;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .profile-icon-btn svg { width: 22px; height: 22px; fill: #fff; }

  .profile-section {
    display: flex;
    align-items: center;
    padding: 14px 14px 10px;
    gap: 14px;
  }
  .profile-avatar-wrap { position: relative; flex-shrink: 0; }
  .profile-avatar {
    width: 80px; height: 80px;
    border-radius: 50%;
    border: 3px solid #f5a623;
    overflow: hidden;
    background: linear-gradient(135deg, #1a1a3e, #0a0a2e);
    display: flex; align-items: center; justify-content: center;
    cursor: pointer;
  }
  .profile-avatar svg { width: 48px; height: 48px; }
  .camera-badge {
    position: absolute;
    bottom: 0; right: 0;
    width: 26px; height: 26px;
    background: #f5a623;
    border-radius: 50%;
    border: 2.5px solid #0a0a0a;
    display: flex; align-items: center; justify-content: center;
    cursor: pointer;
  }
  .camera-badge svg { width: 14px; height: 14px; fill: #000; }
  .profile-info { flex: 1; min-width: 0; }
  .profile-display-name {
    font-size: 16px;
    font-weight: 700;
    color: #fff;
    margin-bottom: 2px;
    word-break: break-word;
  }
  .profile-display-handle {
    font-size: 13px;
    color: #888;
    margin-bottom: 4px;
  }
  .profile-display-email {
    font-size: 11px;
    color: #aaa;
    margin-bottom: 4px;
    word-break: break-all;
  }
  .profile-status-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 4px 10px;
    border-radius: 12px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.5px;
  }
  .status-pending { background: rgba(245,166,35,0.15); color: #f5a623; border: 1px solid rgba(245,166,35,0.4); }
  .status-approved { background: rgba(0,200,150,0.15); color: #00c896; border: 1px solid rgba(0,200,150,0.4); }
  .status-none { background: rgba(255,255,255,0.08); color: #888; border: 1px solid rgba(255,255,255,0.15); }
  .profile-creator-id {
    font-size: 12px;
    color: #f5a623;
    font-weight: 700;
    letter-spacing: 1px;
    margin-top: 4px;
  }

  .stats-row {
    display: flex;
    border-top: 1px solid rgba(255,255,255,0.06);
    border-bottom: 1px solid rgba(255,255,255,0.06);
    margin: 6px 0;
  }
  .stat-item {
    flex: 1;
    text-align: center;
    padding: 14px 8px;
    position: relative;
  }
  .stat-item:not(:last-child)::after {
    content: '';
    position: absolute;
    right: 0; top: 20%; bottom: 20%;
    width: 1px;
    background: rgba(255,255,255,0.08);
  }
  .stat-num { font-size: 22px; font-weight: 800; color: #fff; }
  .stat-label { font-size: 10px; color: #888; font-weight: 600; letter-spacing: 1.2px; margin-top: 2px; }

  .action-buttons {
    display: flex;
    gap: 10px;
    padding: 14px 14px;
  }
  .action-btn-main {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    padding: 11px 8px;
    border-radius: 12px;
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
    border: none;
    font-family: 'Poppins', sans-serif;
  }
  .action-btn-main:active { transform: scale(0.95); }
  .btn-creator {
    background: rgba(99,102,241,0.15);
    border: 1.5px solid rgba(99,102,241,0.5) !important;
    color: #818cf8;
  }
  .btn-creator svg { width: 18px; height: 18px; fill: #818cf8; }
  .btn-edit {
    background: rgba(255,255,255,0.06);
    border: 1.5px solid rgba(255,255,255,0.15) !important;
    color: #fff;
  }
  .btn-promote {
    background: rgba(245,166,35,0.12);
    border: 1.5px solid rgba(245,166,35,0.5) !important;
    color: #f5a623;
  }
  .btn-promote svg { width: 18px; height: 18px; fill: #f5a623; }

  .profile-tabs {
    display: flex;
    border-bottom: 1px solid rgba(255,255,255,0.06);
  }
  .tab-item {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 12px;
    cursor: pointer;
    position: relative;
  }
  .tab-item.active::after {
    content: '';
    position: absolute;
    bottom: 0; left: 25%; right: 25%;
    height: 3px;
    background: #f5a623;
    border-radius: 2px 2px 0 0;
  }
  .tab-item svg { width: 24px; height: 24px; }
  .tab-item.active svg { fill: #f5a623; stroke: none; }
  .tab-item:not(.active) svg { fill: none; stroke: #666; stroke-width: 2; }

  .empty-posts {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 60px 20px;
    color: #666;
  }
  .empty-posts svg { width: 64px; height: 64px; fill: #333; margin-bottom: 16px; }
  .empty-posts .empty-title { font-size: 16px; font-weight: 700; color: #888; margin-bottom: 6px; }
  .empty-posts .empty-sub { font-size: 13px; color: #555; }

  /* ===== ANALYTICS PAGE ===== */
  .analytics-page { background: #0a0a0a; }
  .analytics-header-section {
    padding: 20px 20px 16px;
    border-bottom: 1px solid rgba(255,255,255,0.08);
  }
  .analytics-studio-label {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 700;
    color: #f5a623;
    letter-spacing: 1.5px;
    margin-bottom: 8px;
  }
  .analytics-studio-label svg { width: 20px; height: 20px; fill: #f5a623; }
  .analytics-title {
    font-size: 28px;
    font-weight: 800;
    color: #fff;
  }
  .analytics-perf-card {
    margin: 16px;
    background: linear-gradient(135deg, #1a1a2e, #151528);
    border: 1px solid rgba(245,166,35,0.2);
    border-radius: 16px;
    padding: 20px;
  }
  .analytics-perf-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
  }
  .analytics-perf-title {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 700;
    color: #f5a623;
    letter-spacing: 1px;
  }
  .analytics-perf-title svg { width: 18px; height: 18px; fill: #f5a623; }
  .analytics-uploads {
    font-size: 13px;
    color: #888;
    font-family: monospace;
  }
  .analytics-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .analytics-stat-card {
    background: rgba(0,0,0,0.4);
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: 14px;
    padding: 20px 16px;
    text-align: center;
  }
  .analytics-stat-icon {
    width: 48px; height: 48px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 12px;
  }
  .analytics-stat-icon svg { width: 24px; height: 24px; }
  .icon-views { background: rgba(245,166,35,0.15); border: 1px solid rgba(245,166,35,0.3); }
  .icon-views svg { fill: #f5a623; }
  .icon-watch { background: rgba(0,200,150,0.15); border: 1px solid rgba(0,200,150,0.3); }
  .icon-watch svg { fill: #00c896; }
  .icon-likes { background: rgba(231,76,60,0.15); border: 1px solid rgba(231,76,60,0.3); }
  .icon-likes svg { fill: #e74c3c; }
